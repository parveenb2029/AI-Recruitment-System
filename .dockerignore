# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. Anything listed here is invisible to `docker build`.

.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Secrets and machine-specific config. The entrypoint creates organization.yaml
# from the example on first run; a mounted config/ overrides it.
.env
config/organization.yaml

# Local database and uploaded documents. These belong in volumes, not layers.
data/
build/

# NOTE: the numbered workflow folders are NOT excluded, and must not be.
# `prompts.WorkflowPrompt.load` reads the live system and user prompts from
# 03_Extracted_Data/Prompt.md and 04_Match_Results/Prompt.md at run time — the
# markdown is the governed artefact, not a copy of one. Excluding them builds an
# image whose console works and whose extraction raises PromptError.
