{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF-03 Resume Data Extraction — Full Output",
  "description": "The complete WF-03 response: the shared envelope with 'results' narrowed to the WF-03 payload. This is the schema the orchestrator validates against.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "workflow_id": { "const": "WF-03" }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["SUCCESS", "PARTIAL"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["results"],
        "properties": {
          "results": { "$ref": "WF-03_results.schema.json" }
        }
      }
    }
  ]
}
