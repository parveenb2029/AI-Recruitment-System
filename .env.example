# Copy to .env and fill in. .env is gitignored — secrets never enter the repo.
#
#     cp .env.example .env            (macOS / Linux)
#     copy .env.example .env          (Windows)
#
# Every variable here is OPTIONAL. With an empty .env the review console runs,
# the sample queue seeds, and you can approve and reject candidates — because
# the demo data is produced by a fake model that needs no key. You need a key
# the moment you want to process a resume of your own.
#
# Non-secret settings live in config/organization.yaml. Only credentials and
# environment-specific endpoints belong here.

# -----------------------------------------------------------------------------
# LLM provider — the ONE thing real extraction requires.
# Set the key matching adapters.llm.provider in config/organization.yaml.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# -----------------------------------------------------------------------------
# Docker Compose. Read by docker-compose.yml; ignored when you run on the host.
# -----------------------------------------------------------------------------

# Postgres password inside the compose stack. The default is "recruit", which is
# fine while the port is bound to 127.0.0.1 and nothing else. Change it before
# you change that.
# POSTGRES_PASSWORD=recruit

# The administrator created on first start — and only if adapters.auth.provider
# is "local" and no account exists yet. Leave RECRUIT_ADMIN_PASSWORD empty and a
# strong one is generated and printed once in the container logs; that is the
# recommended path, because a password nobody chose is a password nobody reused.
# RECRUIT_ADMIN_EMAIL=you@example.com
# RECRUIT_ADMIN_PASSWORD=

# Seed the sample queue on start. Set to 0 once real candidates are in the
# database — seeding is idempotent and will not duplicate them, but there is no
# reason to keep re-running it.
# RECRUIT_SEED=1

# -----------------------------------------------------------------------------
# Database. Compose sets this for you. On the host, leaving it unset means
# SQLite at data/recruit.db — no server, no driver to compile.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://recruit:recruit@localhost:5432/recruit

# -----------------------------------------------------------------------------
# Config file location. Only needed when it is not config/organization.yaml.
# -----------------------------------------------------------------------------
# RECRUIT_CONFIG=/etc/recruit/organization.yaml

# -----------------------------------------------------------------------------
# Cloud storage. Only when adapters.storage.provider is not "local".
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AZURE_STORAGE_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# ATS. Only when adapters.ats.provider is not "csv" or "none".
# -----------------------------------------------------------------------------
# GREENHOUSE_API_KEY=
# LEVER_API_KEY=
# WORKDAY_CLIENT_ID=
# WORKDAY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SSO. Only when adapters.auth.provider is "oidc" — not implemented; it raises
# rather than quietly falling back to weaker auth.
# -----------------------------------------------------------------------------
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
